{
  "name": "@mistymoon/dsh",
  "version": "0.0.1-rc.6",
  "description": "Long-term companion plugin suite for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "cordis.patch.yml",
    "packages/settings-ui/lib",
    "packages/identity/lib",
    "packages/foundation/lib",
    "packages/foundation/personas/template/persona.json",
    "packages/foundation/personas/example/persona.json",
    "packages/foundation/presets",
    "packages/installer/lib",
    "packages/memory/lib",
    "packages/work-agent/lib",
    "packages/work-agent/presets",
    "packages/work-agent-dsh/lib"
  ],
  "exports": {
    ".": {
      "types": "./packages/settings-ui/lib/types/index.d.ts",
      "default": "./packages/settings-ui/lib/index.js"
    },
    "./client": {
      "types": "./packages/settings-ui/lib/types/client/index.d.ts",
      "default": "./packages/settings-ui/lib/client.js"
    },
    "./foundation": {
      "types": "./packages/foundation/lib/index.d.ts",
      "default": "./packages/foundation/lib/index.js"
    },
    "./foundation/rp-host": {
      "types": "./packages/foundation/lib/rp-host-composition.d.ts",
      "default": "./packages/foundation/lib/rp-host-composition.js"
    },
    "./identity": {
      "types": "./packages/identity/lib/index.d.ts",
      "default": "./packages/identity/lib/index.js"
    },
    "./memory": {
      "types": "./packages/memory/lib/index.d.ts",
      "default": "./packages/memory/lib/index.js"
    },
    "./memory/domain": {
      "types": "./packages/memory/lib/domain.d.ts",
      "default": "./packages/memory/lib/domain.js"
    },
    "./memory/candidate-extraction": {
      "types": "./packages/memory/lib/candidate-extraction.d.ts",
      "default": "./packages/memory/lib/candidate-extraction.js"
    },
    "./memory/conflict": {
      "types": "./packages/memory/lib/conflict.d.ts",
      "default": "./packages/memory/lib/conflict.js"
    },
    "./memory/retrieval": {
      "types": "./packages/memory/lib/retrieval.d.ts",
      "default": "./packages/memory/lib/retrieval.js"
    },
    "./memory/advanced-retrieval": {
      "types": "./packages/memory/lib/advanced-retrieval.d.ts",
      "default": "./packages/memory/lib/advanced-retrieval.js"
    },
    "./memory/lifecycle": {
      "types": "./packages/memory/lib/lifecycle.d.ts",
      "default": "./packages/memory/lib/lifecycle.js"
    },
    "./memory/legacy-migration": {
      "types": "./packages/memory/lib/legacy-migration.d.ts",
      "default": "./packages/memory/lib/legacy-migration.js"
    },
    "./memory/maintenance": {
      "types": "./packages/memory/lib/maintenance.d.ts",
      "default": "./packages/memory/lib/maintenance.js"
    },
    "./installer": {
      "types": "./packages/installer/lib/index.d.ts",
      "default": "./packages/installer/lib/index.js"
    },
    "./work-agent": {
      "types": "./packages/work-agent/lib/index.d.ts",
      "default": "./packages/work-agent/lib/index.js"
    },
    "./work-agent-dsh": {
      "types": "./packages/work-agent-dsh/lib/index.d.ts",
      "default": "./packages/work-agent-dsh/lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mistymoon-dsh-install": "./packages/installer/lib/cli.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "audit:publication": "tsx scripts/audit-publication.ts",
    "build": "pnpm --filter @mistymoon/dsh-installer run build && pnpm --filter @mistymoon/dsh-identity run build && pnpm --filter @mistymoon/dsh-foundation run build && pnpm --filter @mistymoon/dsh-memory run build && pnpm --filter @mistymoon/dsh-work-agent run build && pnpm --filter @mistymoon/dsh-work-agent-dsh run build && pnpm --filter @mistymoon/dsh-settings-ui run build",
    "preview:dump": "tsx scripts/preview.ts dump",
    "preview:install": "tsx scripts/preview.ts install",
    "preview:migrate-memory": "tsx scripts/migrate-memory.ts",
    "memory:maintenance": "tsx scripts/memory-maintenance.ts",
    "preview:smoke": "tsx scripts/preview.ts smoke",
    "preview:start": "tsx scripts/preview.ts start",
    "prepare": "pnpm run build",
    "prepack": "pnpm run build && pnpm run audit:publication",
    "smoke:built": "node scripts/smoke-built.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:built && pnpm run audit:publication"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "proper-lockfile": "4.1.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-scope": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.1.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-subagent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/react": "18.3.31",
    "js-yaml": "^4.2.0",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
