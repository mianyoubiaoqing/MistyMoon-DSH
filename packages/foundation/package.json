{
  "name": "@mistymoon/dsh-foundation",
  "version": "0.0.1-rc.6",
  "description": "Private persona projection and publication safety for MistyMoon on DSH",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "lib",
    "presets",
    "personas/template/persona.json",
    "personas/example/persona.json"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./persona-document": {
      "types": "./lib/persona-document.d.ts",
      "default": "./lib/persona-document.js"
    },
    "./persona-home": {
      "types": "./lib/persona-home.d.ts",
      "default": "./lib/persona-home.js"
    },
    "./persona-workspace": {
      "types": "./lib/persona-workspace.d.ts",
      "default": "./lib/persona-workspace.js"
    },
    "./character-card": {
      "types": "./lib/character-card.d.ts",
      "default": "./lib/character-card.js"
    },
    "./character-card-container": {
      "types": "./lib/character-card-container.d.ts",
      "default": "./lib/character-card-container.js"
    },
    "./rp-host": {
      "types": "./lib/rp-host-composition.d.ts",
      "default": "./lib/rp-host-composition.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-agent-presets": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-scope": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7 <0.1.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.1",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "@mistymoon/dsh-identity": "workspace:*",
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.7",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/yauzl": "2.10.3",
    "@types/yazl": "3.3.0",
    "yazl": "3.3.1"
  }
}
