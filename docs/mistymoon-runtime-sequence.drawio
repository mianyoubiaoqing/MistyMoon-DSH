        <mxCell id="title" value="&lt;b&gt;MistyMoon Owner Turn — RP、记忆与 Work Agent 委派时序图&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;当前 Foundation/Memory 路径 + Phase 0 Work child seam（产品 provider 尚未注册）&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1800" height="70" as="geometry" />
        </mxCell>

        <mxCell id="pOwner" value="&lt;b&gt;Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;真实用户&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#4B5563;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="45" y="105" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="pDsh" value="&lt;b&gt;DSH Web + Agent Loop&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;会话日志 / 工具 / 请求编排&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="250" y="105" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="pIdentity" value="&lt;b&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;判断本轮是否 Owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#0F766E;strokeWidth=2;fontColor=#134E4A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="505" y="105" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="pFoundation" value="&lt;b&gt;Foundation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Persona / voice 生命周期&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#BE185D;strokeWidth=2;fontColor=#881337;fontSize=14;" vertex="1" parent="1"><mxGeometry x="710" y="105" width="165" height="70" as="geometry" /></mxCell>
        <mxCell id="pMemory" value="&lt;b&gt;Memory&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;正式记忆 / recall&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#B45309;strokeWidth=2;fontColor=#78350F;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="105" width="150" height="70" as="geometry" /></mxCell>
        <mxCell id="pLlm" value="&lt;b&gt;Official DeepSeek Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;模型请求 / 回复&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1135" y="105" width="210" height="70" as="geometry" /></mxCell>
        <mxCell id="pAdapter" value="&lt;b&gt;Work Agent Adapter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;可选；Phase 0 inert&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#312E81;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1400" y="105" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="pChild" value="&lt;b&gt;Fresh Work Child&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;一次任务一个；不继承 RP 历史&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4338CA;strokeWidth=2;fontColor=#312E81;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1650" y="105" width="190" height="70" as="geometry" /></mxCell>

        <mxCell id="lifeOwner" style="endArrow=none;dashed=1;strokeColor=#9CA3AF;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="170" as="sourcePoint" /><mxPoint x="120" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeDsh" style="endArrow=none;dashed=1;strokeColor=#60A5FA;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="170" as="sourcePoint" /><mxPoint x="350" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeIdentity" style="endArrow=none;dashed=1;strokeColor=#34D399;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="170" as="sourcePoint" /><mxPoint x="580" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeFoundation" style="endArrow=none;dashed=1;strokeColor=#FB7185;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="792" y="170" as="sourcePoint" /><mxPoint x="792" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeMemory" style="endArrow=none;dashed=1;strokeColor=#F59E0B;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="170" as="sourcePoint" /><mxPoint x="1005" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeLlm" style="endArrow=none;dashed=1;strokeColor=#60A5FA;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="170" as="sourcePoint" /><mxPoint x="1240" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeAdapter" style="endArrow=none;dashed=1;strokeColor=#818CF8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1495" y="175" as="sourcePoint" /><mxPoint x="1495" y="1210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lifeChild" style="endArrow=none;dashed=1;strokeColor=#818CF8;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="175" as="sourcePoint" /><mxPoint x="1745" y="1210" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="phase1" value="&lt;b&gt;① A. Owner message 与首请求投影&lt;/b&gt;　先认证 Owner，再注入轻量 voice 与已确认记忆，最后发起首个模型请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;fontColor=#374151;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="190" width="1830" height="35" as="geometry" /></mxCell>
        <mxCell id="m1" value="发送真实 owner message" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4B5563;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="250" as="sourcePoint" /><mxPoint x="350" y="250" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="evaluateCurrentTurn(message, session header, rpc evidence)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#0F766E;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="295" as="sourcePoint" /><mxPoint x="580" y="295" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m3" value="eligible / reason" style="endArrow=open;dashed=1;html=1;strokeColor=#0F766E;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="330" as="sourcePoint" /><mxPoint x="350" y="330" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m4" value="agent/pre-step：记录唯一 active mistymoon:turn-voice" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#BE185D;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="375" as="sourcePoint" /><mxPoint x="792" y="375" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m5" value="observe 明确记忆请求；选择 confirmed recall" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#B45309;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="420" as="sourcePoint" /><mxPoint x="1005" y="420" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m6" value="追加带 source 的 recall snapshot 到 DSH session log" style="endArrow=open;dashed=1;html=1;strokeColor=#B45309;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1005" y="460" as="sourcePoint" /><mxPoint x="350" y="460" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m7" value="provider request #1：DSH policy + owner message + turn-voice + recall" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="505" as="sourcePoint" /><mxPoint x="1240" y="505" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="phase2" value="&lt;b&gt;② B. 技术工作 / 可选 Work Agent 委派&lt;/b&gt;　只有需要工具或编码时进入；短对话会跳过本段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#818CF8;fontColor=#312E81;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="535" width="1830" height="35" as="geometry" /></mxCell>
        <mxCell id="m8" value="tool calls / 继续请求（不生成新 persona capsule）" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="600" as="sourcePoint" /><mxPoint x="350" y="600" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m9" value="受信 RP Host/Controller：提交最小任务 envelope" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="645" as="sourcePoint" /><mxPoint x="1495" y="645" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m10" value="resolve publication；创建 fresh depth-one child；空 seed；挂载固定 preset" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1495" y="690" as="sourcePoint" /><mxPoint x="1745" y="690" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m11" value="固定 Flash/max 或 Pro/max；Anchored + Routing（真实组合待 provision）" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="735" as="sourcePoint" /><mxPoint x="1240" y="735" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m12" value="编码 / 研究结果" style="endArrow=open;dashed=1;html=1;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="775" as="sourcePoint" /><mxPoint x="1745" y="775" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m13" value="折叠 Work Report；dispose child" style="endArrow=open;dashed=1;html=1;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1745" y="815" as="sourcePoint" /><mxPoint x="1495" y="815" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m14" value="返回结构化结果（不含 parent RP transcript）" style="endArrow=open;dashed=1;html=1;strokeColor=#4338CA;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1495" y="855" as="sourcePoint" /><mxPoint x="350" y="855" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="phase3" value="&lt;b&gt;③ C. 最终回复的互斥双阶段 voice&lt;/b&gt;　prepare 表示技术工作完成；随后仅有一次无工具 final 请求" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;fontColor=#881337;fontSize=13;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="885" width="1830" height="35" as="geometry" /></mxCell>
        <mxCell id="m15" value="继续 provider request：携带同一 turn-voice" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="945" as="sourcePoint" /><mxPoint x="1240" y="945" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m16" value="唯一 tool call：mistymoon_prepare_final_reply" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#BE185D;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="985" as="sourcePoint" /><mxPoint x="350" y="985" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m17" value="重新认证当前 Owner turn" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#0F766E;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1025" as="sourcePoint" /><mxPoint x="580" y="1025" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m18" value="neutral superseded + queue final-voice-refresh + tools.restrict([])" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#BE185D;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1065" as="sourcePoint" /><mxPoint x="792" y="1065" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m19" value="final request：唯一 active refresh；无工具" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1105" as="sourcePoint" /><mxPoint x="1240" y="1105" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m20" value="owner-facing final assistant message" style="endArrow=open;dashed=1;html=1;strokeColor=#2563EB;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1240" y="1145" as="sourcePoint" /><mxPoint x="350" y="1145" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m21" value="consume refresh；写 neutral lifecycle；恢复工具" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#BE185D;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1180" as="sourcePoint" /><mxPoint x="792" y="1180" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m22" value="呈现最终回复" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#4B5563;fontSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="1215" as="sourcePoint" /><mxPoint x="120" y="1215" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="guard" value="&lt;b&gt;Fail-closed 分支&lt;/b&gt;：delegation depth &gt; 0 或认证证据缺失 → 不读 Persona、不召回现实记忆、不开放治理工具；publication 漂移 → child transaction 回滚；prepare 非唯一 / RP off / persona 读取失败 → 不排队 refresh，不做事后改写。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="170" y="1240" width="1560" height="45" as="geometry" /></mxCell>

        <mxCell id="readingGuideSequence" value="&lt;b&gt;如何读这张图&lt;/b&gt;：时间从上到下；参与者从左到右；实线是调用/请求，虚线是返回/结果；② 技术工作段是可选的。&lt;br&gt;① Owner 消息先经 Identity 认证；Foundation 写本轮轻量语气，Memory 只投影已确认事实，然后 DSH 发起首个模型请求。&lt;br&gt;② 需要编码/研究时，RP Host 只交出最小任务；Adapter 创建不含 RP 历史的一次性 child，结果返回后立即 dispose。&lt;br&gt;③ 模型以唯一 prepare tool call 宣告准备最终回复；Foundation 中和旧 voice、临时禁用工具，只让下一次 final 请求使用完整 refresh；完成后恢复工具。&lt;br&gt;&lt;b&gt;红色 Fail-closed：&lt;/b&gt;任何身份、publication 或 prepare 条件不成立时，都不猜测、不补写、不绕过 DSH 安全能力。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E3A8A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="45" y="1310" width="1810" height="115" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
